{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcstack:contracts:telemetry-event:1.0",
  "title": "rcstack telemetry event",
  "description": "One row of ~/.rcstack/telemetry.jsonl, appended by scripts/log-telemetry.mjs at the end of a Tier 2+ run. Uses only keywords enforced by scripts/verify.mjs. The cross-field rule reviewer_model != builder_model cannot be expressed here and is enforced by scripts/log-telemetry.mjs, together with calendar validity of the timestamp.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp",
    "repo",
    "branch",
    "profile",
    "playbook",
    "risk_tier",
    "builder_model",
    "reviewer_model",
    "degraded_single_harness",
    "first_pass_verify_passed",
    "audit_blockers",
    "audit_majors",
    "audit_nits",
    "human_override"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "timestamp": {
      "description": "ISO-8601 UTC instant, e.g. 2026-01-15T09:30:00Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "repo": {
      "description": "Repository basename or owner/name slug. Never a local filesystem path.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)?$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250,
      "pattern": "^\\S+$"
    },
    "profile": { "enum": ["rcstack-engineering", "rcstack-study", "rcstack-research"] },
    "playbook": {
      "description": "<domain>/<playbook>, e.g. engineering/feature-build.",
      "type": "string",
      "pattern": "^(?:engineering|study|research)/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "risk_tier": { "type": "integer", "minimum": 0, "maximum": 3 },
    "builder_model": {
      "description": "The builder of record: the model that authored the audited work.",
      "$ref": "#/$defs/model_name"
    },
    "reviewer_model": {
      "description": "The model that audited the work. Must differ from builder_model. null only at Tier 0/1 or in a degraded single harness.",
      "anyOf": [{ "$ref": "#/$defs/model_name" }, { "type": "null" }]
    },
    "degraded_single_harness": { "type": "boolean" },
    "first_pass_verify_passed": { "type": "boolean" },
    "audit_blockers": { "type": "integer", "minimum": 0 },
    "audit_majors": { "type": "integer", "minimum": 0 },
    "audit_nits": { "type": "integer", "minimum": 0 },
    "human_override": { "type": "boolean" },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "allOf": [
    {
      "$comment": "A Tier 2+ run in an orchestrated environment must name its reviewer.",
      "if": {
        "required": ["risk_tier", "degraded_single_harness"],
        "properties": {
          "risk_tier": { "type": "integer", "minimum": 2 },
          "degraded_single_harness": { "const": false }
        }
      },
      "then": { "properties": { "reviewer_model": { "type": "string" } } }
    },
    {
      "if": { "required": ["profile"], "properties": { "profile": { "const": "rcstack-engineering" } } },
      "then": { "properties": { "playbook": { "pattern": "^engineering/" } } }
    },
    {
      "if": { "required": ["profile"], "properties": { "profile": { "const": "rcstack-study" } } },
      "then": { "properties": { "playbook": { "pattern": "^study/" } } }
    },
    {
      "if": { "required": ["profile"], "properties": { "profile": { "const": "rcstack-research" } } },
      "then": { "properties": { "playbook": { "pattern": "^research/" } } }
    }
  ],
  "$defs": {
    "model_name": {
      "description": "A concrete model name as resolved from the active profile: single line, no leading or trailing whitespace.",
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^\\S(?:.*\\S)?$"
    }
  }
}
