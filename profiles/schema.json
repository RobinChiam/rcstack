{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcstack:profiles:schema:1.0",
  "title": "rcstack routing profile",
  "description": "Contract for profiles/*.yaml and ~/.rcstack/profiles/*.yaml: binds abstract capabilities to concrete models with portable descriptors, defines the reviewer matrix, and sets the gates of risk tiers 0-3. Uses only keywords scripts/verify.mjs enforces. Cross-entry invariants JSON Schema cannot express (review_matrix coverage, reviewer != builder, exclusive bindings, the Tier 2-3 gate floor, no machine-specific identifiers) are enforced by scripts/verify.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "domain",
    "description",
    "invariants",
    "tier3_path_patterns",
    "capabilities",
    "review_matrix",
    "risk_tiers"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile": { "enum": ["rcstack-engineering", "rcstack-study", "rcstack-research"] },
    "domain": { "enum": ["engineering", "study", "research"] },
    "description": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "invariants": {
      "description": "Non-negotiable review guarantees. Every value is pinned; a profile cannot opt out.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_reviewer_not_equal_builder",
        "require_fresh_context_audit",
        "allow_self_review_on_fallback"
      ],
      "properties": {
        "require_reviewer_not_equal_builder": { "const": true },
        "require_fresh_context_audit": { "const": true },
        "allow_self_review_on_fallback": { "const": false }
      }
    },
    "tier3_path_patterns": {
      "description": "Repo-relative globs. Any target or touched path matching one escalates the run to Tier 3. '*' and '?' stay within one path segment; a '**' segment spans any number of directories.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/glob" }
    },
    "capabilities": {
      "description": "Abstract capability -> model binding. independent_reviewer is deliberately absent: it is resolved through review_matrix for the builder of record.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systems_research",
        "architect_blueprint",
        "primary_builder",
        "security_builder",
        "vibe_executor",
        "deep_grounding",
        "quick_lookup"
      ],
      "properties": {
        "systems_research": { "$ref": "#/$defs/binding" },
        "architect_blueprint": { "$ref": "#/$defs/binding" },
        "primary_builder": { "$ref": "#/$defs/binding" },
        "security_builder": { "$ref": "#/$defs/binding" },
        "vibe_executor": { "$ref": "#/$defs/binding" },
        "deep_grounding": { "$ref": "#/$defs/binding" },
        "quick_lookup": { "$ref": "#/$defs/binding" }
      }
    },
    "review_matrix": {
      "description": "Builder model name -> its reviewers, plus the required default_fallback reviewer. Every model bound to systems_research, architect_blueprint, primary_builder, security_builder or vibe_executor (primary, secondary, fallback) must have an entry, and no reviewer in an entry may equal its builder.",
      "type": "object",
      "minProperties": 2,
      "required": ["default_fallback"],
      "propertyNames": { "$ref": "#/$defs/model_name" },
      "properties": {
        "default_fallback": { "$ref": "#/$defs/model_name" }
      },
      "additionalProperties": { "$ref": "#/$defs/review_entry" }
    },
    "risk_tiers": {
      "description": "Gates per risk tier. Tier N has the assurance floor A<N>.",
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2", "3"],
      "properties": {
        "0": {
          "allOf": [
            { "$ref": "#/$defs/risk_tier" },
            { "properties": { "required_assurance": { "const": "A0" } } }
          ]
        },
        "1": {
          "allOf": [
            { "$ref": "#/$defs/risk_tier" },
            { "properties": { "required_assurance": { "const": "A1" } } }
          ]
        },
        "2": {
          "allOf": [
            { "$ref": "#/$defs/risk_tier" },
            { "properties": { "required_assurance": { "const": "A2" } } }
          ]
        },
        "3": {
          "allOf": [
            { "$ref": "#/$defs/risk_tier" },
            { "properties": { "required_assurance": { "const": "A3" } } }
          ]
        }
      }
    }
  },
  "$defs": {
    "alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "alias_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/alias"
        },
        "secondary": {
          "$ref": "#/$defs/alias"
        },
        "fallback": {
          "$ref": "#/$defs/alias"
        },
        "paired": {
          "$ref": "#/$defs/alias"
        },
        "companion": {
          "$ref": "#/$defs/alias"
        },
        "exclusive": {
          "type": "boolean"
        }
      }
    },
    "alias_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/alias"
        },
        "tier1_primary": {
          "$ref": "#/$defs/alias"
        },
        "fallback": {
          "$ref": "#/$defs/alias"
        }
      }
    },
    "main_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "description",
        "capabilities",
        "default_capabilities"
      ],
      "properties": {
        "profile_id": {
          "enum": [
            "rcstack-engineering",
            "rcstack-study",
            "rcstack-research"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "systems_research": {
              "$ref": "#/$defs/alias_binding"
            },
            "architect_blueprint": {
              "$ref": "#/$defs/alias_binding"
            },
            "primary_builder": {
              "$ref": "#/$defs/alias_binding"
            },
            "security_builder": {
              "$ref": "#/$defs/alias_binding"
            },
            "vibe_executor": {
              "$ref": "#/$defs/alias_binding"
            },
            "deep_grounding": {
              "$ref": "#/$defs/alias_binding"
            },
            "quick_lookup": {
              "$ref": "#/$defs/alias_binding"
            }
          }
        },
        "default_capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "0",
            "1",
            "2",
            "3"
          ],
          "properties": {
            "0": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/capability"
              }
            },
            "1": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/capability"
              }
            },
            "2": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/capability"
              }
            },
            "3": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/capability"
              }
            }
          }
        }
      }
    },
    "main_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required_assurance",
        "require_spec",
        "require_state_file",
        "require_verify",
        "require_receipt_gate",
        "require_cross_model_audit",
        "require_review_map",
        "log_telemetry"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "required_assurance": {
          "enum": [
            "A0",
            "A1",
            "A2",
            "A3"
          ]
        },
        "require_spec": {
          "type": "boolean"
        },
        "require_state_file": {
          "type": "boolean"
        },
        "require_verify": {
          "type": "boolean"
        },
        "require_receipt_gate": {
          "type": "boolean"
        },
        "require_cross_model_audit": {
          "type": "boolean"
        },
        "require_review_map": {
          "type": "boolean"
        },
        "log_telemetry": {
          "type": "boolean"
        }
      }
    },
    "main_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile",
        "models",
        "invariants",
        "tier3_path_patterns",
        "capabilities",
        "domains",
        "review_matrix",
        "risk_tiers"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "profile": {
          "const": "rcstack-main"
        },
        "models": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/alias"
          },
          "additionalProperties": {
            "$ref": "#/$defs/model_ref"
          }
        },
        "invariants": {
          "$ref": "#/properties/invariants"
        },
        "tier3_path_patterns": {
          "$ref": "#/properties/tier3_path_patterns"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "systems_research",
            "architect_blueprint",
            "primary_builder",
            "security_builder",
            "vibe_executor",
            "deep_grounding",
            "quick_lookup"
          ],
          "properties": {
            "systems_research": {
              "$ref": "#/$defs/alias_binding"
            },
            "architect_blueprint": {
              "$ref": "#/$defs/alias_binding"
            },
            "primary_builder": {
              "$ref": "#/$defs/alias_binding"
            },
            "security_builder": {
              "$ref": "#/$defs/alias_binding"
            },
            "vibe_executor": {
              "$ref": "#/$defs/alias_binding"
            },
            "deep_grounding": {
              "$ref": "#/$defs/alias_binding"
            },
            "quick_lookup": {
              "$ref": "#/$defs/alias_binding"
            }
          }
        },
        "domains": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engineering",
            "study",
            "research"
          ],
          "properties": {
            "engineering": {
              "$ref": "#/$defs/main_domain"
            },
            "study": {
              "$ref": "#/$defs/main_domain"
            },
            "research": {
              "$ref": "#/$defs/main_domain"
            }
          }
        },
        "review_matrix": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/alias"
          },
          "additionalProperties": {
            "$ref": "#/$defs/alias_review"
          },
          "properties": {
            "default_fallback": {
              "$ref": "#/$defs/alias"
            }
          },
          "required": [
            "default_fallback"
          ]
        },
        "risk_tiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "0",
            "1",
            "2",
            "3"
          ],
          "properties": {
            "0": {
              "$ref": "#/$defs/main_tier"
            },
            "1": {
              "$ref": "#/$defs/main_tier"
            },
            "2": {
              "$ref": "#/$defs/main_tier"
            },
            "3": {
              "$ref": "#/$defs/main_tier"
            }
          }
        }
      }
    },
    "model_name": {
      "description": "A concrete model or tool name as shown to humans: single line, no leading or trailing whitespace. rc-router maps it to a live catalog id at dispatch time.",
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "driver_kind": {
      "description": "Portable provider driver kind as reported by live discovery (never a machine-specific provider instance id). 'external' marks a companion tool that is not dispatched through the orchestrator.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "glob": {
      "description": "A repo-relative glob: no whitespace, no backslashes, no leading slash.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\\\/][^\\s\\\\]*$"
    },
    "options": {
      "description": "Provider options passed through at dispatch, for example an effort level.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "boolean", "integer"] }
    },
    "model_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver_kind", "model"],
      "properties": {
        "driver_kind": { "$ref": "#/$defs/driver_kind" },
        "model": { "$ref": "#/$defs/model_name" },
        "options": { "$ref": "#/$defs/options" }
      }
    },
    "binding": {
      "description": "Primary model plus its optional chain: secondary (tried before fallback), fallback, paired (works alongside the primary), companion (external tool), and exclusive (the model serves this capability only).",
      "type": "object",
      "additionalProperties": false,
      "required": ["driver_kind", "model"],
      "properties": {
        "driver_kind": { "$ref": "#/$defs/driver_kind" },
        "model": { "$ref": "#/$defs/model_name" },
        "options": { "$ref": "#/$defs/options" },
        "secondary": { "$ref": "#/$defs/model_ref" },
        "fallback": { "$ref": "#/$defs/model_ref" },
        "paired": { "$ref": "#/$defs/model_ref" },
        "companion": { "$ref": "#/$defs/model_ref" },
        "exclusive": { "type": "boolean" }
      }
    },
    "review_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "fallback"],
      "properties": {
        "primary": { "$ref": "#/$defs/model_name" },
        "tier1_primary": { "$ref": "#/$defs/model_name" },
        "fallback": { "$ref": "#/$defs/model_name" }
      }
    },
    "capability": {
      "description": "Every abstract capability a risk tier or playbook may name: the seven bound capabilities plus independent_reviewer.",
      "enum": [
        "systems_research",
        "architect_blueprint",
        "primary_builder",
        "security_builder",
        "vibe_executor",
        "deep_grounding",
        "quick_lookup",
        "independent_reviewer"
      ]
    },
    "risk_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required_assurance",
        "default_capabilities",
        "require_spec",
        "require_state_file",
        "require_verify",
        "require_receipt_gate",
        "require_cross_model_audit",
        "require_review_map",
        "log_telemetry"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "required_assurance": { "enum": ["A0", "A1", "A2", "A3"] },
        "default_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "require_spec": { "type": "boolean" },
        "require_state_file": { "type": "boolean" },
        "require_verify": { "type": "boolean" },
        "require_receipt_gate": { "type": "boolean" },
        "require_cross_model_audit": { "type": "boolean" },
        "require_review_map": { "type": "boolean" },
        "log_telemetry": { "type": "boolean" }
      }
    }
  }
}
